<Project Sdk="Microsoft.NET.Sdk">
  <!-- Deliberately the hostile end of the spectrum: 32-bit .NET Framework, like CSTW. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loadstar.Net\Loadstar.Net.csproj" />
  </ItemGroup>

  <!-- Native DLL from the i686 release build (see README "Building"); build that first. -->
  <ItemGroup>
    <None Include="..\..\..\target\i686-pc-windows-msvc\release\loadstar.dll" Link="loadstar.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
